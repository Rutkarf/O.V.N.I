# Copier vers application-oidc.yml et activer le profil Spring `oidc`.
# Dépendance runtime : spring-boot-starter-oauth2-client (ajouter au pom si besoin).
fruitfly:
  security:
    enabled: true
    oidc:
      enabled: true
      issuer-uri: https://auth.example.org/realms/luminy
      client-id: fruitfly
      client-secret: change-me

