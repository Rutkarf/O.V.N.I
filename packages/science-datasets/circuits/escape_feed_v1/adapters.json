{
  "version": "1.1.0",
  "dataset_claim": "motif_literature_escape_feed_v1",
  "notes": "Engineered sensory adapters + policy knobs for reproducible motif simulation. All fields are hypotheses for Methods.",
  "inputs": {
    "sugar": {
      "targets": ["sugar_sensory"],
      "max_rate_hz": 100.0,
      "gain_by_hunger": 1.4
    },
    "bitter": {
      "targets": ["bitter_sensory"],
      "max_rate_hz": 100.0
    },
    "looming": {
      "targets": ["LPLC2", "LC4"],
      "max_rate_hz": 80.0,
      "bypass_retina": true
    }
  },
  "policies": {
    "bitter_suppresses_sugar": true,
    "bitter_gate_threshold": 0.45,
    "bitter_sugar_scale": 0.12,
    "shuffle_keep_fraction": 0.2,
    "syn_strength": 8.0,
    "syn_tau_ms": 5.0
  },
  "readouts": {
    "ESCAPE": {
      "neurons": ["DNp01_L", "DNp01_R"],
      "rule": "any_spike",
      "window_ms": 50
    },
    "EAT": {
      "neurons": ["MN9"],
      "rule": "spike_count_ge",
      "count": 3,
      "window_ms": 80
    },
    "IDLE": {
      "rule": "default"
    }
  },
  "priority": ["ESCAPE", "EAT", "IDLE"],
  "parameters": {
    "dt_ms": 0.1,
    "duration_ms": 500,
    "v_rest": -65.0,
    "v_reset": -70.0,
    "v_thresh": -50.0,
    "tau_ms": 20.0,
    "r_mohm": 10.0,
    "refractory_ms": 2.0
  }
}
